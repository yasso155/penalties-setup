rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared tables: any signed-in user can read and write
    match /existing/{doc}  { allow read, write: if request.auth != null; }
    match /settings/{doc}  { allow read, write: if request.auth != null; }
    // Each user's own working draft
    match /drafts/{uid}    { allow read, write: if request.auth != null && request.auth.uid == uid; }
  }
}
